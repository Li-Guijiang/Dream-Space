# 数据库（MySQL）
DATABASE_URL=mysql+pymysql://USER:PASSWORD@127.0.0.1:3306/Dream-Space

# 应用密钥
SECRET_KEY=your-secret-key-change-me

# CORS 允许的来源（逗号分隔）
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://your-domain.com

# GitHub OAuth（可选）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 阿里云 OSS（可选，不填则图片上传到本地 uploads 目录）
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_ENDPOINT=
OSS_CUSTOM_DOMAIN=
OSS_PREFIX=
